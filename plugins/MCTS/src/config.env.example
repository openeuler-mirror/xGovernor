# 旧版手工启动配置（run_union.sh）；当前接入由 xg 宿主拉起插件，见 ../README.md「接入 xg」。
# 需要的是 xg 侧 MCTS_REPO_ROOT / MCTS_PYTHON_BIN，请求走 POST /api/v1/mcts/runs。
# E2B_API_KEY and model credentials belong to the SERVER environment.
export XGOVERNOR_BASE_URL="http://127.0.0.1:8787"
# Match the listener: admin token for 8787, tenant token for 8788.
export XGOVERNOR_API_TOKEN=""
export XGOVERNOR_RUNTIME="xiaoo"  # xiaoo | pi; --runtime takes precedence

# Required on the tenant listener; optional on admin (empty = daemon_default).
# Public HTTPS Git URL without embedded credentials; REF may be empty.
export XGOVERNOR_WORKSPACE_GIT_URL=""
export XGOVERNOR_WORKSPACE_GIT_REF=""

# xiaoo requires PROVIDER, MODEL and KEY_ENV; API_BASE is optional.
# pi may use its own server-side defaults; explicit model settings are recommended.
# KEY_ENV is an environment variable NAME resolved on the server, not its value.
export XGOVERNOR_LLM_PROVIDER=""
export XGOVERNOR_LLM_MODEL=""
export XGOVERNOR_LLM_API_BASE=""
export XGOVERNOR_LLM_KEY_ENV=""

# Terminal usage includes Author/Solver, memory merging and selector.
# This is a soft limit checked after completed/failed turns; 0 disables it.
export XIAOO_MCTS_TOKEN_FUSE_LIMIT="30000000"
export XGOVERNOR_ROLLOUT_IDLE_TIMEOUT_SECS="300"

export ZSOFT_TASKS_DIR="/home/lcy/muyuan-sec/benchmarks/vulnerability/zsoft-l1/tasks"
# ZSoft official judge is host-owned; configure its command and private assets
# in the host runtime. The plugin does not read a local URL or binary path.
